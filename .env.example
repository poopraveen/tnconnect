# Database
DATABASE_URL="postgresql://user:password@localhost:5432/trustnest"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Image uploads: S3 and/or Cloudinary (see lib/uploads.ts)
# UPLOAD_PROVIDER: unset = use S3 if configured, else Cloudinary. Or force: "s3" | "cloudinary"

# AWS S3 (optional if using Cloudinary only)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="trustnest-properties"
# Only if your bucket allows ACLs (Object Ownership != "Bucket owner enforced"). Otherwise use a bucket policy for public GetObject on uploads.
# AWS_S3_USE_PUBLIC_ACL="true"

# Cloudinary (optional if using S3 only) — https://cloudinary.com/console
# Option A — single URL from the dashboard (recommended):
# CLOUDINARY_URL="cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>"
# Option B — separate vars:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# OpenAI (for AI recommendations)
OPENAI_API_KEY=""

# Pusher (for real-time chat)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# White-label branding (real-estate groups)
NEXT_PUBLIC_BRAND_NAME="PooPrav TrustNest"
NEXT_PUBLIC_BRAND_WORDMARK_PREFIX="PooPrav Trust"
NEXT_PUBLIC_BRAND_WORDMARK_ACCENT="Nest"
NEXT_PUBLIC_BRAND_TAGLINE="India's Most Trusted Real Estate Platform"
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL="support@trustnest.in"
NEXT_PUBLIC_BRAND_OFFICE_ADDRESS="Corporate Office, Bandra Kurla Complex, Mumbai 400051"
# Optional: long SEO description (defaults to a template using BRAND_NAME)
# NEXT_PUBLIC_BRAND_META_DESCRIPTION=""
NEXT_PUBLIC_MAPS_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
